import "../../justfile"

# Extract copperlists from the caterpillar log.
cl:
	#!/usr/bin/env bash
	set -euo pipefail
	RUST_BACKTRACE=1 cargo run -r --bin cu-caterpillar-logreader logs/caterpillar.copper extract-copperlists

fsck:
	#!/usr/bin/env bash
	set -euo pipefail
	RUST_BACKTRACE=1 cargo run -r --bin cu-caterpillar-logreader logs/caterpillar.copper fsck

fsck-resim:
	#!/usr/bin/env bash
	set -euo pipefail
	RUST_BACKTRACE=1 cargo run -r --bin cu-caterpillar-logreader logs/caterpillarresim.copper fsck

cmp:
  #!/usr/bin/env bash
  cmp logs/caterpillar_0.copper logs/caterpillarresim_0.copper

# Extract a text log using the caterpillar logreader.
logreader:
	#!/usr/bin/env bash
	set -euo pipefail
	RUST_BACKTRACE=1 cargo run -r --bin cu-caterpillar-logreader logs/caterpillar.copper extract-text-log ../../target/debug/cu29_log_index


# Run the resim binary against the recorded caterpillar log.
resim:
	#!/usr/bin/env bash
	set -euo pipefail
	RUST_BACKTRACE=1 cargo run --profile debug-optimized --features sim-debug --bin cu-caterpillar-resim -- \
		--log-base logs/caterpillar.copper

resim-debug debug_base="copper/examples/cu_caterpillar/debug/v1" log="logs/caterpillar.copper" replay_log="logs/caterpillarresim.copper":
	#!/usr/bin/env bash
	set -euo pipefail
	invocation_dir="{{invocation_directory()}}"
	log="{{log}}"
	replay_log="{{replay_log}}"
	if [[ "$log" != /* ]]; then
		log="${invocation_dir}/${log}"
	fi
	if [[ "$replay_log" != /* ]]; then
		replay_log="${invocation_dir}/${replay_log}"
	fi
	RUST_BACKTRACE=1 cargo run --profile debug-optimized --features sim-debug --bin cu-caterpillar-resim -- \
		--debug-base "{{debug_base}}" \
		--log-base "$log" \
		--replay-log-base "$replay_log"

# Convert the caterpillar log to MCAP and show a summary.
mcap:
	#!/usr/bin/env bash
	set -euo pipefail

	copper_base="logs/caterpillar.copper"
	mcap_file="logs/caterpillar.mcap"

	echo "=========================================="
	echo "Converting: ${copper_base} -> ${mcap_file}"
	echo "=========================================="

	# Export to MCAP (Copper will automatically find all _0, _1, _2... slabs)
	cargo run --bin cu-caterpillar-logreader --profile screaming -- "${copper_base}" export-mcap --output "${mcap_file}"

	echo ""
	echo "=========================================="
	echo "MCAP Info for: ${mcap_file}"
	echo "=========================================="

	# Run mcap-info to show the user what was created
	cargo run --bin cu-caterpillar-logreader --profile screaming -- "${copper_base}" mcap-info "${mcap_file}"
