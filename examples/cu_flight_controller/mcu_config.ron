(
    includes: [
        (
            path: "mcu_config.ron.in",
            params: {"record_auxiliary": false, "record_rate_tuning": true},
            when: Feature("firmware"),
        ),
        (
            path: "mcu_config.ron.in",
            params: {"record_auxiliary": true, "record_rate_tuning": false},
            when: Not(Feature("firmware")),
        ),
    ],
)
