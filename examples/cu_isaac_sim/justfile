import "../../justfile"

isaac_image := "nvcr.io/nvidia/isaac-sim:6.1.0"
export ISAAC_EXAMPLE := justfile_directory()
export ISAAC_STATE := justfile_directory() / "state"

# Shared Docker flags; each recipe below supplies its command directly.
isaac_container := replace('''
    docker run --rm --init --gpus all --network host --shm-size 2g
        --user "$(id -u):$(id -g)"
        --group-add 1234
        --env HOME=/home/copper
        --env ACCEPT_EULA=Y --env PRIVACY_CONSENT=N
        --env NVIDIA_DRIVER_CAPABILITIES=all
        --env HUB__ARGS__DETECT_ONLY=false
        --entrypoint /bin/bash --workdir /isaac-sim
        --mount "type=bind,src=$ISAAC_EXAMPLE/isaac,dst=/workspace/isaac,readonly"
        --mount "type=bind,src=$ISAAC_STATE/output,dst=/output"
        --mount "type=bind,src=$ISAAC_STATE/home,dst=/home/copper"
        --mount "type=bind,src=$ISAAC_STATE/cache/main,dst=/home/copper/.cache"
        --mount "type=bind,src=$ISAAC_STATE/cache/computecache,dst=/home/copper/.nv/ComputeCache"
        --mount "type=bind,src=$ISAAC_STATE/cache/kit,dst=/isaac-sim/kit/cache"
        --mount "type=bind,src=$ISAAC_STATE/cache/hub,dst=/var/cache/hub"
        --mount "type=bind,src=$ISAAC_STATE/config,dst=/home/copper/.nvidia-omniverse/config"
        --mount "type=bind,src=$ISAAC_STATE/data,dst=/home/copper/.local/share/ov/data"
        --mount "type=bind,src=$ISAAC_STATE/logs,dst=/home/copper/.nvidia-omniverse/logs"
        --mount "type=bind,src=$ISAAC_STATE/pkg,dst=/home/copper/.local/share/ov/pkg"
        --mount "type=bind,src=$ISAAC_STATE/kit/data,dst=/isaac-sim/kit/data"
        --mount "type=bind,src=$ISAAC_STATE/kit/logs,dst=/isaac-sim/kit/logs"
''', "\n", " ")

[private]
_state:
    mkdir -p "$ISAAC_STATE"/home "$ISAAC_STATE"/kit/data "$ISAAC_STATE"/kit/logs "$ISAAC_STATE"/cache/main "$ISAAC_STATE"/cache/computecache "$ISAAC_STATE"/cache/kit "$ISAAC_STATE"/cache/hub "$ISAAC_STATE"/config "$ISAAC_STATE"/data "$ISAAC_STATE"/logs "$ISAAC_STATE"/pkg "$ISAAC_STATE"/output
    mkdir -p "$ISAAC_STATE"/home/.cache "$ISAAC_STATE"/home/.nv/ComputeCache "$ISAAC_STATE"/home/.nvidia-omniverse/config "$ISAAC_STATE"/home/.nvidia-omniverse/logs "$ISAAC_STATE"/home/.local/share/ov/data "$ISAAC_STATE"/home/.local/share/ov/pkg

# Download the pinned NVIDIA image.
pull:
    docker pull {{isaac_image}}

# Run NVIDIA's headless compatibility checker with GPU passthrough.
compatibility: _state
    {{isaac_container}} {{isaac_image}} ./isaac-sim.compatibility_check.sh --/app/quitAfter=10 --no-window

# Validate the approach and sensors, then pause in the overview for inspection.
gui: _state
    test -n "$DISPLAY" && test -d /tmp/.X11-unix
    test -r "${XAUTHORITY:-$HOME/.Xauthority}"
    {{isaac_container}} \
        --hostname "$(hostname)" --env DISPLAY --env XAUTHORITY=/tmp/isaac.Xauthority \
        --mount type=bind,src=/tmp/.X11-unix,dst=/tmp/.X11-unix,readonly \
        --mount "type=bind,src=${XAUTHORITY:-$HOME/.Xauthority},dst=/tmp/isaac.Xauthority,readonly" \
        {{isaac_image}} ./python.sh /workspace/isaac/smoke.py --mode gui --output /output/gui

# Check settling, floor, clearance, onboard RGB, and complete RTX lidar scans.
headless: _state
    {{isaac_container}} {{isaac_image}} ./python.sh /workspace/isaac/smoke.py --mode headless --output /output/headless

# Open a shell in the same GPU container with persistent caches.
shell: _state
    {{isaac_container}} -it {{isaac_image}}

# Run the native Copper graph with Isaac; use `just run headless` without a window.
[default]
run mode="gui" observations=(if mode == "gui" { "0" } else { "130" }) *args: _state
    #!/usr/bin/env bash
    set -euo pipefail
    test "{{mode}}" = gui || test "{{mode}}" = headless
    cargo build --profile debug-optimized --manifest-path "$ISAAC_EXAMPLE/Cargo.toml"
    mkdir -p "$ISAAC_EXAMPLE/logs"
    echo "Isaac output: $ISAAC_EXAMPLE/logs/isaac.log"
    session="$(mktemp -d /tmp/cu-isaac-XXXXXX)"
    native_pid=""
    cleanup() {
        if test -n "$native_pid"; then
            kill "$native_pid" 2>/dev/null || true
            wait "$native_pid" 2>/dev/null || true
        fi
        rm -rf "$session"
    }
    trap cleanup EXIT
    # Preserve terminal input for ConsoleMon in this background process.
    TMPDIR="$session" "$ROOT/target/debug-optimized/cu-isaac-sim" --session "$session" --log "$ISAAC_EXAMPLE/logs/$(basename "$session").copper" {{args}} <&0 &
    native_pid=$!
    {{isaac_container}} \
        --mount "type=bind,src=$session,dst=$session" \
        {{if mode == "gui" { '--hostname "$(hostname)" --env DISPLAY --env XAUTHORITY=/tmp/isaac.Xauthority --mount type=bind,src=/tmp/.X11-unix,dst=/tmp/.X11-unix,readonly --mount "type=bind,src=${XAUTHORITY:-$HOME/.Xauthority},dst=/tmp/isaac.Xauthority,readonly"' } else { '' } }} \
        {{isaac_image}} ./python.sh /workspace/isaac/smoke.py --mode {{mode}} --output /output/{{mode}} --session "$session" --observations {{observations}} >"$ISAAC_EXAMPLE/logs/isaac.log" 2>&1
    wait "$native_pid"
    native_pid=""
