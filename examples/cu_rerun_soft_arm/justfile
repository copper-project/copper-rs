# Run the Copper app with live Rerun visualization and Copper logging.
[default]
run:
    cargo run --manifest-path "{{justfile_directory()}}/Cargo.toml" --bin cu-rerun-soft-arm

# Record one gesture to Copper and RRD without opening a window.
save path="soft-arm.rrd":
    cargo run --manifest-path "{{justfile_directory()}}/Cargo.toml" --bin cu-rerun-soft-arm -- --save {{quote(path)}}

# Serve the last Copper recording to Timetraveler.
debug log="logs/soft-arm.copper" debug_base="copper/examples/cu_rerun_soft_arm/debug/v1":
    cargo run --manifest-path "{{justfile_directory()}}/Cargo.toml" --no-default-features --features debug --bin soft-arm-resim -- --log-base {{quote(log)}} --debug-base {{quote(debug_base)}}
