        ),
        (
            id: "WORLD_TO_CAMERA",
            module: "transforms",
            type: "cu_transform::TypedTransform3D<f32, cu_transform::WorldFrame, cu_transform::CameraFrame>",
            expression: "crate::transforms::WORLD_TO_ROBOT.then(crate::transforms::ROBOT_TO_CAMERA)",
        ),
