            expression: "cu_transform::TypedTransform3D::<f32, cu_transform::WorldFrame, cu_transform::RobotFrame>::from_translation_euler_xyz(crate::frames::robot::ROBOT_TRANSLATION, crate::frames::robot::ROBOT_ROTATION)",
        ),
        (
            id: "ROBOT_TO_CAMERA",
            module: "transforms",
