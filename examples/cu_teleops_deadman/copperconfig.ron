(
    logging: (
        copperlist_count: 2,
        enable_task_logging: true,
        enable_keyframe_logging: true,
        keyframe_interval: 64,
        section_size_mib: 1,
        slab_size_mib: 8,
    ),
    resources: [(id: "ops", provider: "crate::Ops")],
    tasks: [
        (id: "button", type: "crate::controls::ButtonSource", resources: {"inbox": "ops.button"}),
        (id: "tick", type: "crate::Tick"),
        (id: "safety", type: "crate::Deadman"),
    ],
    cnx: [
        (src: "button", dst: "safety", msg: "bool"),
        (src: "tick", dst: "safety", msg: "cu29::clock::CuTime"),
        (src: "safety", dst: "__nc__", msg: "crate::Safety"),
    ],
)
