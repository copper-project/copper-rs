        (src: "ndt_localizer", dst: "behavior_planner_input_1", msg: "crate::payload::RefSample"),
        (src: "behavior_planner_input_1", dst: "__nc__", msg: "crate::payload::RefSample"),
        (src: "lanelet2_global_planner", dst: "behavior_planner_input_2", msg: "crate::payload::RefSample"),
        (src: "behavior_planner_input_2", dst: "__nc__", msg: "crate::payload::RefSample"),
        (src: "lanelet2_map_loader", dst: "behavior_planner_input_3", msg: "crate::payload::RefSample"),
        (src: "behavior_planner_input_3", dst: "__nc__", msg: "crate::payload::RefSample"),
        (src: "parking_planner", dst: "behavior_planner_input_4", msg: "crate::payload::RefSample"),
