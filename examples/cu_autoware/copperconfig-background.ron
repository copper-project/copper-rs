            kind: task,
            background: true,
            config: { "crunch_limit": 110181 },
        ),
        (
            id: "object_collision_estimator",
            type: "crate::tasks::RefCallbackTransform<23>",
            kind: task,
            background: true,
            config: { "crunch_limit": 109495 },
        ),
        (
            id: "behavior_planner_input_0",
            type: "crate::tasks::RefCallbackTransform<24>",
            kind: task,
            background: true,
            config: { "crunch_limit": 100 },
        ),
        (
            id: "behavior_planner_input_1",
            type: "crate::tasks::RefCallbackTransform<25>",
            kind: task,
            background: true,
            config: { "crunch_limit": 100 },
        ),
        (
            id: "behavior_planner_input_2",
            type: "crate::tasks::RefCallbackTransform<26>",
            kind: task,
            background: true,
            config: { "crunch_limit": 100 },
        ),
        (
            id: "behavior_planner_input_3",
            type: "crate::tasks::RefCallbackTransform<27>",
            kind: task,
            background: true,
            config: { "crunch_limit": 100 },
        ),
        (
            id: "behavior_planner_input_4",
            type: "crate::tasks::RefCallbackTransform<28>",
            kind: task,
            background: true,
            config: { "crunch_limit": 100 },
        ),
        (
            id: "behavior_planner_input_5",
            type: "crate::tasks::RefCallbackTransform<29>",
            kind: task,
            background: true,
            config: { "crunch_limit": 100 },
        ),
        (
            id: "behavior_planner",
            type: "crate::tasks::RefCallbackSensor<30>",
            kind: source,
            background: true,
            config: { "period_ms": 100, "crunch_limit": 3374 },
        ),
        (
            id: "mpc_controller",
            type: "crate::tasks::RefCallbackTransform<31>",
            kind: task,
            background: true,
            config: { "crunch_limit": 109495 },
        ),
        (
            id: "vehicle_interface",
            type: "crate::tasks::RefCallbackTransform<32>",
            kind: task,
            background: true,
            config: { "crunch_limit": 109495 },
        ),
        (
            id: "vehicle_interface_behavior_callback",
            type: "crate::tasks::RefCallbackTransform<33>",
            kind: task,
            background: true,
            config: { "crunch_limit": 33926 },
        ),
        (
            id: "vehicle_dbw",
            type: "crate::tasks::RefCallbackTransform<34>",
            kind: task,
            background: true,
            config: { "crunch_limit": 19320 },
        ),
        (
            id: "intersection_output",
            type: "crate::tasks::RefCallbackTransform<35>",
            kind: task,
            background: true,
            config: { "crunch_limit": 19320 },
        ),
    ],
    cnx: [
        (src: "front_lidar", dst: "points_transformer_front", msg: "crate::payload::RefSample"),
        (src: "rear_lidar", dst: "points_transformer_rear", msg: "crate::payload::RefSample"),
        (src: "points_transformer_front", dst: "point_cloud_fusion", msg: "crate::payload::RefSample"),
        (src: "points_transformer_rear", dst: "point_cloud_fusion_rear_callback", msg: "crate::payload::RefSample"),
        (src: "point_cloud_fusion_rear_callback", dst: "__nc__", msg: "crate::payload::RefSample"),
        (src: "point_cloud_fusion", dst: "voxel_grid_downsampler", msg: "crate::payload::RefSample"),
        (src: "point_cloud_fusion", dst: "ray_ground_filter", msg: "crate::payload::RefSample"),
        (src: "point_cloud_map", dst: "point_cloud_map_loader", msg: "crate::payload::RefSample"),
        (src: "point_cloud_map_loader", dst: "ndt_localizer", msg: "crate::payload::RefSample"),
        (src: "voxel_grid_downsampler", dst: "ndt_localizer_voxel_callback", msg: "crate::payload::RefSample"),
        (src: "ndt_localizer_voxel_callback", dst: "__nc__", msg: "crate::payload::RefSample"),
        (src: "visualizer", dst: "lanelet2_global_planner", msg: "crate::payload::RefSample"),
        (src: "ndt_localizer", dst: "lanelet2_global_planner_ndt_callback", msg: "crate::payload::RefSample"),
        (src: "lanelet2_global_planner_ndt_callback", dst: "__nc__", msg: "crate::payload::RefSample"),
        (src: "lanelet2_map", dst: "lanelet2_map_loader", msg: "crate::payload::RefSample"),
        (src: "lanelet2_global_planner", dst: "lanelet2_map_loader_global_callback", msg: "crate::payload::RefSample"),
        (src: "lanelet2_map_loader_global_callback", dst: "__nc__", msg: "crate::payload::RefSample"),
        (src: "lanelet2_map_loader", dst: "parking_planner", msg: "crate::payload::RefSample"),
        (src: "lanelet2_map_loader", dst: "lane_planner", msg: "crate::payload::RefSample"),
        (src: "ray_ground_filter", dst: "euclidean_cluster_detector", msg: "crate::payload::RefSample"),
        (src: "euclidean_cluster_settings", dst: "euclidean_cluster_detector_settings_callback", msg: "crate::payload::RefSample"),
