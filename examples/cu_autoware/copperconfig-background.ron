        (src: "mpc_controller", dst: "vehicle_interface", msg: "crate::payload::RefSample"),
        (src: "vehicle_interface", dst: "vehicle_dbw", msg: "crate::payload::RefSample"),
        (src: "vehicle_dbw", dst: "__nc__", msg: "crate::payload::RefSample"),
        (src: "intersection_output", dst: "__nc__", msg: "crate::payload::RefSample"),
    ],
    monitor: (type: "cu_consolemon::CuConsoleMon"),
)
