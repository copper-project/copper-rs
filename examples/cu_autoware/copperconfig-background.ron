// Callback-level form of the Autoware reference system. Unlike copperconfig.ron, every
// schedulable ROS callback is one static Copper node. All work uses Copper's existing
// background-task wrapper and a two-thread fair pool, matching LaME's observed CPU budget
// without changing Copper internals. The six 1us cache callbacks deliberately keep the
// fixed minimum crunch limit used by the vanilla graph.
(
    runtime: (
        rate_target_hz: 200,
        thread_pools: [
            (
                id: "background",
                threads: 2,
                policy: Fair,
            ),
        ],
    ),
    // Background callbacks may still be active at a CopperList boundary. Keep the
    // CopperLists used for KPI extraction, but compile task-state keyframes out.
    logging: (
        enable_keyframe_logging: false,
    ),
    tasks: [
        (
            id: "front_lidar",
            type: "crate::tasks::RefCallbackSensor<0>",
            kind: source,
            background: true,
            config: { "period_ms": 200, "crunch_limit": 3374 },
        ),
        (
            id: "rear_lidar",
            type: "crate::tasks::RefCallbackSensor<1>",
            kind: source,
            background: true,
            config: { "period_ms": 200, "crunch_limit": 3374 },
        ),
        (
            id: "point_cloud_map",
            type: "crate::tasks::RefCallbackSensor<2>",
            kind: source,
            background: true,
            config: { "period_ms": 120, "crunch_limit": 3374 },
        ),
        (
            id: "visualizer",
            type: "crate::tasks::RefCallbackSensor<3>",
            kind: source,
            background: true,
            config: { "period_ms": 60, "crunch_limit": 3374 },
        ),
        (
            id: "lanelet2_map",
            type: "crate::tasks::RefCallbackSensor<4>",
            kind: source,
            background: true,
            config: { "period_ms": 100, "crunch_limit": 3374 },
        ),
        (
            id: "euclidean_cluster_settings",
            type: "crate::tasks::RefCallbackSensor<5>",
            kind: source,
            background: true,
            config: { "period_ms": 25, "crunch_limit": 3374 },
        ),
        (
            id: "points_transformer_front",
            type: "crate::tasks::RefCallbackTransform<6>",
            kind: task,
            background: true,
            config: { "crunch_limit": 109495 },
        ),
        (
            id: "points_transformer_rear",
            type: "crate::tasks::RefCallbackTransform<7>",
            kind: task,
            background: true,
            config: { "crunch_limit": 109495 },
        ),
        (
            id: "point_cloud_fusion",
            type: "crate::tasks::RefCallbackTransform<8>",
            kind: task,
            background: true,
            config: { "crunch_limit": 108734 },
        ),
        (
            id: "point_cloud_fusion_rear_callback",
            type: "crate::tasks::RefCallbackTransform<9>",
            kind: task,
            background: true,
            config: { "crunch_limit": 33926 },
        ),
        (
            id: "voxel_grid_downsampler",
            type: "crate::tasks::RefCallbackTransform<10>",
            kind: task,
            background: true,
            config: { "crunch_limit": 109495 },
        ),
        (
            id: "ray_ground_filter",
            type: "crate::tasks::RefCallbackTransform<11>",
            kind: task,
            background: true,
            config: { "crunch_limit": 109495 },
        ),
        (
            id: "point_cloud_map_loader",
            type: "crate::tasks::RefCallbackTransform<12>",
            kind: task,
            background: true,
            config: { "crunch_limit": 109495 },
        ),
        (
            id: "ndt_localizer",
            type: "crate::tasks::RefCallbackTransform<13>",
            kind: task,
            background: true,
            config: { "crunch_limit": 109495 },
        ),
        (
            id: "ndt_localizer_voxel_callback",
            type: "crate::tasks::RefCallbackTransform<14>",
            kind: task,
            background: true,
            config: { "crunch_limit": 33926 },
        ),
        (
            id: "lanelet2_global_planner",
            type: "crate::tasks::RefCallbackTransform<15>",
            kind: task,
            background: true,
            config: { "crunch_limit": 110181 },
        ),
        (
            id: "lanelet2_global_planner_ndt_callback",
            type: "crate::tasks::RefCallbackTransform<16>",
            kind: task,
            background: true,
            config: { "crunch_limit": 33926 },
        ),
        (
            id: "lanelet2_map_loader",
            type: "crate::tasks::RefCallbackTransform<17>",
            kind: task,
            background: true,
            config: { "crunch_limit": 110181 },
        ),
        (
            id: "lanelet2_map_loader_global_callback",
            type: "crate::tasks::RefCallbackTransform<18>",
            kind: task,
            background: true,
            config: { "crunch_limit": 33926 },
        ),
        (
            id: "parking_planner",
            type: "crate::tasks::RefCallbackTransform<19>",
            kind: task,
            background: true,
            config: { "crunch_limit": 109495 },
        ),
        (
            id: "lane_planner",
            type: "crate::tasks::RefCallbackTransform<20>",
            kind: task,
            background: true,
            config: { "crunch_limit": 109495 },
        ),
        (
            id: "euclidean_cluster_detector",
