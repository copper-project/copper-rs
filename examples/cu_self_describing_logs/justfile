import "../../support/just/viewers.just"

default: run catalog fsck

# Record a startup catalog and ten wheel samples.
run:
    cargo run --features self-describing-logs

# Inspect the recorded catalog; use --export-format ron or json for complete dumps.
catalog *args:
    cargo run --quiet -p cu29-export --features self-describing-logs --bin cu29-logextract -- logs/wheel.copper catalog {{args}}

# Extract complete messages; use --export-format jsonl or csv as needed.
extract *args:
    cargo run --quiet -p cu29-export --features self-describing-logs --bin cu29-logextract -- logs/wheel.copper extract-copperlists {{args}}

# Decode all recorded payloads and check the selected run.
fsck:
    cargo run --quiet -p cu29-export --features self-describing-logs --bin cu29-logextract -- logs/wheel.copper fsck --deep

# Exercise automatic startup recording and catalog rejection.
check:
    cargo test --features self-describing-logs
