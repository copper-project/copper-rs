(
    resources: [
        (
            id: "ptp",
            provider: "cu_ptp::LinuxPtpBundle",
            config: {
                "device": "/dev/ptp0",
                "management": "/var/run/ptp4l",
                "reference_error_ns": 1000000,
                "allow_local_master": true,
            },
        ),
    ],
    runtime: (clock: (parent: "ptp.reference", max_error_ns: 20000000), rate_target_hz: 20),
    tasks: [(id: "stamp", type: "tasks::Sample"), (id: "consume", type: "tasks::Consume")],
    cnx: [(src: "stamp", dst: "consume", msg: "u64")],
    logging: (enable_task_logging: true, slab_size_mib: 4, section_size_mib: 1),
    monitor: (type: "cu_consolemon::CuConsoleMon"),
)
