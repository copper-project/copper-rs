# Application, replay, and visualization helpers.

log log="logs/{{project-name|kebab_case}}.copper":
  cargo run --features logreader --bin {{project-name|kebab_case}}-logreader -- "{% raw %}{{log}}{% endraw %}" extract-text-log target/debug/cu29_log_index

cl log="logs/{{project-name|kebab_case}}.copper":
  cargo run --features logreader --bin {{project-name|kebab_case}}-logreader -- "{% raw %}{{log}}{% endraw %}" extract-copperlists

resim log="logs/{{project-name|kebab_case}}.copper":
  cargo run --profile debug-optimized --features sim-debug --bin {{project-name|kebab_case}}-resim -- --log-base "{% raw %}{{log}}{% endraw %}"

resim-debug debug_base="copper/projects/{{project-name|snake_case}}/debug/v1" log="logs/{{project-name|kebab_case}}.copper" replay_log="logs/{{project-name|kebab_case}}_resim.copper":
  cargo run --profile debug-optimized --features sim-debug --bin {{project-name|kebab_case}}-resim -- --debug-base "{% raw %}{{debug_base}}{% endraw %}" --log-base "{% raw %}{{log}}{% endraw %}" --replay-log-base "{% raw %}{{replay_log}}{% endraw %}"

graph config="copperconfig.ron" output="graph.svg":
  cargo run --bin {{project-name|kebab_case}}-view -- graph --config "{% raw %}{{config}}{% endraw %}" --output "{% raw %}{{output}}{% endraw %}" --open

# Compatibility alias for the former graph recipe.
dag config="copperconfig.ron" output="graph.svg":
  @echo "just dag is deprecated; use just graph" >&2
  just graph "{% raw %}{{config}}{% endraw %}" "{% raw %}{{output}}{% endraw %}"

graph-log config="copperconfig.ron" log="logs/{{project-name|kebab_case}}.copper" output="graph-log.svg":
  cargo run --bin {{project-name|kebab_case}}-view -- graph --config "{% raw %}{{config}}{% endraw %}" --log "{% raw %}{{log}}{% endraw %}" --output "{% raw %}{{output}}{% endraw %}" --open

sched config="copperconfig.ron" output="schedule.svg":
  cargo run --bin {{project-name|kebab_case}}-view -- schedule --config "{% raw %}{{config}}{% endraw %}" --output "{% raw %}{{output}}{% endraw %}" --open

sched-log config="copperconfig.ron" log="logs/{{project-name|kebab_case}}.copper" output="schedule-log.svg":
  cargo run --bin {{project-name|kebab_case}}-view -- schedule --config "{% raw %}{{config}}{% endraw %}" --log "{% raw %}{{log}}{% endraw %}" --output "{% raw %}{{output}}{% endraw %}" --open

{% if pgs_enabled %}
pgs-baseline log="logs/pgs-baseline.copper":
  cargo run --release --bin {{project-name|kebab_case}} -- --log "{% raw %}{{log}}{% endraw %}"
  cargo run --bin {{project-name|kebab_case}}-view -- graph --config copperconfig.ron --log "{% raw %}{{log}}{% endraw %}" --output target/pgs/baseline.graph.svg
  cargo run --bin {{project-name|kebab_case}}-view -- schedule --config copperconfig.ron --log "{% raw %}{{log}}{% endraw %}" --output target/pgs/baseline.schedule.svg

pgs-optimize candidates="3" baseline="logs/pgs-baseline.copper":
  cargo run --features logreader --bin {{project-name|kebab_case}}-logreader -- "{% raw %}{{baseline}}{% endraw %}" optimize-schedule --contract schedule.ron --output target/pgs --candidates "{% raw %}{{replace(candidates, "candidates=", "")}}{% endraw %}"
  cargo run --bin {{project-name|kebab_case}}-pgs -- render-predictions --candidates "{% raw %}{{replace(candidates, "candidates=", "")}}{% endraw %}"

pgs-candidate candidate="1":
  cargo run --bin {{project-name|kebab_case}}-pgs -- select --candidate "{% raw %}{{replace(candidate, "candidate=", "")}}{% endraw %}"
  cargo run --release --features parallel-rt,pgs-candidate --bin {{project-name|kebab_case}}-pgs-candidate -- --log "logs/pgs-candidate-{% raw %}{{replace(candidate, "candidate=", "")}}{% endraw %}.copper"
  cargo run --bin {{project-name|kebab_case}}-pgs -- render-candidate --candidate "{% raw %}{{replace(candidate, "candidate=", "")}}{% endraw %}"

pgs-measure candidates="1" baseline="logs/pgs-baseline.copper":
  cargo run --bin {{project-name|kebab_case}}-pgs -- measure --candidates "{% raw %}{{replace(candidates, "candidates=", "")}}{% endraw %}" --baseline "{% raw %}{{baseline}}{% endraw %}"
{% endif %}
