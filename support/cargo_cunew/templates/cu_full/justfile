# Workspace automation helpers.

# Render the execution DAG from the app config.
dag:
  #!/usr/bin/env bash
  set -euo pipefail
  APP_DIR="${APP_DIR:-cu_example_app}"
  {% if copper_source == "local" %}
  cargo run --manifest-path "{{copper_root_path}}/Cargo.toml" -p cu29-runtime --bin cu29-rendercfg -- \
    apps/"${APP_DIR}"/copperconfig.ron --open
  {% else %}
  renderer="$(command -v cu29-rendercfg || true)"
  if [[ -z "$renderer" ]]; then
    echo "cu29-rendercfg not found on PATH; installing it now..." >&2
    {% if copper_source == "crates.io" %}
    cargo install --locked cu29-runtime --version "{{copper_version}}" --bin cu29-rendercfg
    {% elsif copper_source == "git" %}
    cargo install --locked --git "{{copper_git_url}}" {% if copper_git_branch != "__none__" %}--branch "{{copper_git_branch}}" {% elsif copper_git_tag != "__none__" %}--tag "{{copper_git_tag}}" {% elsif copper_git_rev != "__none__" %}--rev "{{copper_git_rev}}" {% endif %} --bin cu29-rendercfg cu29-runtime
    {% endif %}
    renderer="$(command -v cu29-rendercfg || true)"
    if [[ -z "$renderer" ]]; then
      renderer="${CARGO_HOME:-$HOME/.cargo}/bin/cu29-rendercfg"
    fi
  fi
  [[ -x "$renderer" ]] || { echo "Failed to find cu29-rendercfg after installation." >&2; exit 1; }
  "$renderer" apps/"${APP_DIR}"/copperconfig.ron --open
  {% endif %}

# Compatibility alias for older template docs.
rcfg: dag

# Render the exact generated per-CopperList process schedule.
[positional-arguments]
plan *options:
  #!/usr/bin/env bash
  set -euo pipefail
  APP_DIR="${APP_DIR:-cu_example_app}"
  config="apps/${APP_DIR}/copperconfig.ron"
  output="apps/${APP_DIR}/plan.svg"
  args=("$config" --output "$output" --open)
  mission_value=""
  features_value=""
  for option in "$@"; do
    case "$option" in
      mission=*) mission_value="${option#mission=}" ;;
      features=*) features_value="${option#features=}" ;;
      *)
        echo "Unknown plan option '$option'; expected mission=<id> or features=<a,b>." >&2
        exit 2
        ;;
    esac
  done
  [[ -z "$mission_value" ]] || args+=(--mission "$mission_value")
  [[ -z "$features_value" ]] || args+=(--features "$features_value")
  {% if copper_source == "local" %}
  cargo run --manifest-path "{{copper_root_path}}/Cargo.toml" -p cu29-runtime --bin cu29-plan -- "${args[@]}"
  {% else %}
  planner="$(command -v cu29-plan || true)"
  if [[ -z "$planner" ]]; then
    echo "cu29-plan not found on PATH; installing it now..." >&2
    {% if copper_source == "crates.io" %}
    cargo install --locked cu29-runtime --version "{{copper_version}}" --bin cu29-plan
    {% elsif copper_source == "git" %}
    cargo install --locked --git "{{copper_git_url}}" {% if copper_git_branch != "__none__" %}--branch "{{copper_git_branch}}" {% elsif copper_git_tag != "__none__" %}--tag "{{copper_git_tag}}" {% elsif copper_git_rev != "__none__" %}--rev "{{copper_git_rev}}" {% endif %} --bin cu29-plan cu29-runtime
    {% endif %}
    planner="$(command -v cu29-plan || true)"
    [[ -n "$planner" ]] || planner="${CARGO_HOME:-$HOME/.cargo}/bin/cu29-plan"
  fi
  [[ -x "$planner" ]] || { echo "Failed to find cu29-plan after installation." >&2; exit 1; }
  "$planner" "${args[@]}"
  {% endif %}

# Extract the structured log via the log reader.
log:
  #!/usr/bin/env bash
  set -euo pipefail
  APP_DIR="${APP_DIR:-cu_example_app}"
  APP_NAME="${APP_NAME:-${APP_DIR}}"
  RUST_BACKTRACE=1 cargo run -p "${APP_NAME}" --features=logreader --bin "${APP_NAME}-logreader" \
    apps/"${APP_DIR}"/logs/"${APP_NAME}".copper extract-text-log target/debug/cu29_log_index

# Extract CopperLists from the log output.
cl:
  #!/usr/bin/env bash
  set -euo pipefail
  APP_DIR="${APP_DIR:-cu_example_app}"
  APP_NAME="${APP_NAME:-${APP_DIR}}"
  RUST_BACKTRACE=1 cargo run -p "${APP_NAME}" --features=logreader --bin "${APP_NAME}-logreader" \
    apps/"${APP_DIR}"/logs/"${APP_NAME}".copper extract-copperlists

resim:
  #!/usr/bin/env bash
  set -euo pipefail
  APP_DIR="${APP_DIR:-cu_example_app}"
  APP_NAME="${APP_NAME:-${APP_DIR}}"
  RUST_BACKTRACE=1 cargo run -p "${APP_NAME}" --features=sim-debug --bin "${APP_NAME}-resim" -- \
    --log-base "apps/${APP_DIR}/logs/${APP_NAME}.copper"

resim-debug debug_base="":
  #!/usr/bin/env bash
  set -euo pipefail
  APP_DIR="${APP_DIR:-cu_example_app}"
  APP_NAME="${APP_NAME:-${APP_DIR}}"
  DEBUG_BASE="{% raw %}{{debug_base}}{% endraw %}"
  if [[ -z "$DEBUG_BASE" ]]; then
    DEBUG_BASE="copper/apps/${APP_NAME}/debug/v1"
  fi
  RUST_BACKTRACE=1 cargo run -p "${APP_NAME}" --features=sim-debug --bin "${APP_NAME}-resim" -- \
    --debug-base "$DEBUG_BASE" \
    --log-base "apps/${APP_DIR}/logs/${APP_NAME}.copper" \
    --replay-log-base "apps/${APP_DIR}/logs/${APP_NAME}_resim.copper"
