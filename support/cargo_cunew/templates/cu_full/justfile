# Workspace application, replay, and visualization helpers.

log app="cu_example_app" log="apps/cu_example_app/logs/cu_example_app.copper":
  cargo run -p "{% raw %}{{app}}{% endraw %}" --features logreader --bin "{% raw %}{{app}}{% endraw %}-logreader" -- "{% raw %}{{log}}{% endraw %}" extract-text-log target/debug/cu29_log_index

cl app="cu_example_app" log="apps/cu_example_app/logs/cu_example_app.copper":
  cargo run -p "{% raw %}{{app}}{% endraw %}" --features logreader --bin "{% raw %}{{app}}{% endraw %}-logreader" -- "{% raw %}{{log}}{% endraw %}" extract-copperlists

resim app="cu_example_app" log="apps/cu_example_app/logs/cu_example_app.copper":
  cargo run --profile debug-optimized -p "{% raw %}{{app}}{% endraw %}" --features sim-debug --bin "{% raw %}{{app}}{% endraw %}-resim" -- --log-base "{% raw %}{{log}}{% endraw %}"

resim-debug app="cu_example_app" log="apps/cu_example_app/logs/cu_example_app.copper" replay_log="apps/cu_example_app/logs/cu_example_app_resim.copper" debug_base="copper/apps/cu_example_app/debug/v1":
  cargo run --profile debug-optimized -p "{% raw %}{{app}}{% endraw %}" --features sim-debug --bin "{% raw %}{{app}}{% endraw %}-resim" -- --debug-base "{% raw %}{{debug_base}}{% endraw %}" --log-base "{% raw %}{{log}}{% endraw %}" --replay-log-base "{% raw %}{{replay_log}}{% endraw %}"

graph-view app="cu_example_app" config="" output="":
  cargo run -p cu29-view-helper -- graph --app "{% raw %}{{app}}{% endraw %}" --config "{% raw %}{{config}}{% endraw %}" --output "{% raw %}{{output}}{% endraw %}" --open

graph-view-log app="cu_example_app" config="" log="apps/cu_example_app/logs/cu_example_app.copper" output="":
  cargo run -p cu29-view-helper -- graph --app "{% raw %}{{app}}{% endraw %}" --config "{% raw %}{{config}}{% endraw %}" --log "{% raw %}{{log}}{% endraw %}" --output "{% raw %}{{output}}{% endraw %}" --open

schedule-view app="cu_example_app" config="" output="":
  cargo run -p cu29-view-helper -- schedule --app "{% raw %}{{app}}{% endraw %}" --config "{% raw %}{{config}}{% endraw %}" --output "{% raw %}{{output}}{% endraw %}" --open

schedule-view-log app="cu_example_app" config="" log="apps/cu_example_app/logs/cu_example_app.copper" output="":
  cargo run -p cu29-view-helper -- schedule --app "{% raw %}{{app}}{% endraw %}" --config "{% raw %}{{config}}{% endraw %}" --log "{% raw %}{{log}}{% endraw %}" --output "{% raw %}{{output}}{% endraw %}" --open

{% if pgs_enabled %}
pgs-baseline log="apps/cu_example_app/logs/pgs-baseline.copper":
  cargo run --release -p cu_example_app --bin cu_example_app -- --log "{% raw %}{{log}}{% endraw %}"
  cargo run -p cu29-view-helper -- graph --log "{% raw %}{{log}}{% endraw %}" --output apps/cu_example_app/target/pgs/baseline.graph.svg
  cargo run -p cu29-view-helper -- schedule --log "{% raw %}{{log}}{% endraw %}" --output apps/cu_example_app/target/pgs/baseline.schedule.svg

pgs-optimize candidates="3" baseline="apps/cu_example_app/logs/pgs-baseline.copper":
  cargo run -p cu_example_app --features logreader --bin cu_example_app-logreader -- "{% raw %}{{baseline}}{% endraw %}" optimize-schedule --contract apps/cu_example_app/schedule.ron --output apps/cu_example_app/target/pgs --candidates "{% raw %}{{replace(candidates, "candidates=", "")}}{% endraw %}"
  cargo run -p cu_example_app --bin cu_example_app-pgs -- render-predictions --candidates "{% raw %}{{replace(candidates, "candidates=", "")}}{% endraw %}"

pgs-candidate candidate="1":
  cargo run -p cu_example_app --bin cu_example_app-pgs -- select --candidate "{% raw %}{{replace(candidate, "candidate=", "")}}{% endraw %}"
  cargo run --release -p cu_example_app --features parallel-rt,pgs-candidate --bin cu_example_app-pgs-candidate -- --log "apps/cu_example_app/logs/pgs-candidate-{% raw %}{{replace(candidate, "candidate=", "")}}{% endraw %}.copper"
  cargo run -p cu_example_app --bin cu_example_app-pgs -- render-candidate --candidate "{% raw %}{{replace(candidate, "candidate=", "")}}{% endraw %}"

pgs-measure candidates="1" baseline="apps/cu_example_app/logs/pgs-baseline.copper":
  cargo run -p cu_example_app --bin cu_example_app-pgs -- measure --candidates "{% raw %}{{replace(candidates, "candidates=", "")}}{% endraw %}" --baseline "{% raw %}{{baseline}}{% endraw %}"
{% endif %}
