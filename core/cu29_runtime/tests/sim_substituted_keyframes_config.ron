(
    logging: (
        keyframe_interval: 1,
        // The replay test requires both recorded iterations regardless of
        // async serializer scheduling, plus one slot for continued execution.
        copperlist_count: 3,
    ),
    tasks: [
        (
            id: "src",
            type: "StatefulSrc",
        ),
        (
            id: "task",
            type: "StatefulTask",
        ),
        (
            id: "sink",
            type: "StatefulSink",
        ),
    ],
    cnx: [
        (
            src: "src",
            dst: "task",
            msg: "ValueMsg",
        ),
        (
            src: "task",
            dst: "sink",
            msg: "ValueMsg",
        ),
    ],
)