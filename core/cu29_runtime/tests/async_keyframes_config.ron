(
    runtime: (
        thread_pools: [
            (id: "source_pool", threads: 1),
            (id: "first_pool", threads: 1),
            (id: "second_pool", threads: 1),
        ],
    ),
    logging: (enable_task_logging: true, slab_size_mib: 16, keyframe_interval: 1),
    tasks: [
        (
            id: "source",
            type: "ControlledSource",
            background: (pool: "source_pool"),
            config: {"gate": 0},
        ),
        (
            id: "first",
            type: "ControlledTask",
            background: (pool: "first_pool"),
            config: {"gate": 1},
        ),
        (
            id: "second",
            type: "ControlledTask",
            background: (pool: "second_pool"),
            config: {"gate": 2},
        ),
        (id: "sink", type: "OutputSink"),
    ],
    cnx: [
        (src: "source", dst: "first", msg: "WorkMsg"),
        (src: "first", dst: "second", msg: "WorkMsg"),
        (src: "second", dst: "sink", msg: "WorkMsg"),
    ],
)
