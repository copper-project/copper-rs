(
    logging: (
        keyframe_interval: 1,
        // The replay tests require both recorded iterations regardless of
        // async serializer scheduling, plus one slot for continued execution.
        copperlist_count: 3,
    ),
    tasks: [
        (
            id: "src",
            type: "MySrc",
            run_in_sim: true,
        ),
        (
            id: "sink",
            type: "MySink",
            run_in_sim: true,
        ),
    ],
    bridges: [
        (
            id: "bridge",
            type: "DummyBridge",
            run_in_sim: false,
            channels: [
                Tx(
                    id: "tx",
                    msg: "Ping",
                ),
                Rx(
                    id: "rx",
                    msg: "Pong",
                ),
            ],
        ),
    ],
    cnx: [
        (
            src: "src",
            dst: "bridge/tx",
            msg: "Ping",
        ),
        (
            src: "bridge/rx",
            dst: "sink",
            msg: "Pong",
        ),
    ],
)